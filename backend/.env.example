# VoiceBridge AI - Backend Configuration

# Server Port
PORT=5000
NODE_ENV=development

# ---------------------------------------------------------------------
# Gnani.ai API Configuration (Official Base URL: https://api.vachana.ai)
# ---------------------------------------------------------------------
# Enter your official Gnani API Key below (passed in header X-API-Key-ID):
GNANI_API_KEY=

# Gnani Base URL (Default: https://api.vachana.ai)
GNANI_BASE_URL=https://api.vachana.ai

# Gnani Prisma V3.0 (STT) Settings
# Models: prisma-v3.0 (multilingual Indic auto-detect), prisma-v2.5
GNANI_PRISMA_MODEL=prisma-v3.0
GNANI_DEFAULT_LANGUAGE=indic-auto

# Gnani Timbre V3.0 (TTS) Settings
# Models: timbre-v3.0 (expressive), timbre-v2.5
# Voices for v3.0: Shivani (Female), Avinash (Male)
# Voices for v2.5: Nalini (Female), Deepak (Male), Kaveri (Female)
GNANI_TIMBRE_MODEL=timbre-v3.0
GNANI_TIMBRE_VOICE=Shivani

# ---------------------------------------------------------------------
# AI Reasoning & LLM Configuration
# Priority: Evon Endpoint -> HF Token -> Groq -> Gemini -> OpenAI -> Local -> Offline Engine
# ---------------------------------------------------------------------

# 1. Gnani Evon (Self-hosted via vLLM or custom OpenAI-compatible endpoint)
# e.g., EVON_API_BASE_URL=http://localhost:8000/v1
EVON_API_BASE_URL=
EVON_API_KEY=
EVON_MODEL_NAME=gnani/gnani-evon-v3.3-30B-A3B

# 2. Gnani Evon via Hugging Face User Access Token (read token)
HF_API_TOKEN=

# 3. Groq API (High-speed Llama 3.3/3.1 inference)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 4. Google Gemini API (gemini-1.5-flash / gemini-1.5-pro)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 5. OpenAI API (gpt-4o-mini / gpt-4o)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 6. Anthropic API (claude-3-5-sonnet-20241022)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 7. Local LLM / Ollama (OpenAI-compatible)
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=llama3.2

# Set to true to force simulation mode without making external API calls
MOCK_MODE=false
